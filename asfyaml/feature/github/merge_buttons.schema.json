{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/apache/infrastructure-asfyaml/refs/heads/main/asfyaml/feature/github/merge_buttons.schema.json",
  "title": "Merge buttons",
  "description": "Enables or disables the pull request merge methods. At least one of squash, merge and rebase must be enabled. See: https://github.com/apache/infrastructure-asfyaml#merge",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "squash": {
      "description": "Allow squash merging.",
      "$ref": "../../common.schema.json#/definitions/bool"
    },
    "squash_commit_message": {
      "type": "string",
      "description": "Default commit message for squash merges.",
      "enum": ["DEFAULT", "PR_TITLE", "PR_TITLE_AND_COMMIT_DETAILS", "PR_TITLE_AND_DESC"]
    },
    "merge": {
      "description": "Allow merge commits.",
      "$ref": "../../common.schema.json#/definitions/bool"
    },
    "merge_commit_message": {
      "type": "string",
      "description": "Default commit message for merge commits.",
      "enum": ["DEFAULT", "PR_TITLE", "PR_TITLE_AND_DESC"]
    },
    "rebase": {
      "description": "Allow rebase merging.",
      "$ref": "../../common.schema.json#/definitions/bool"
    }
  }
}
